{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["./.cloudflare/types/index.d.ts", "node"]
  },
  "include": [
    "server/**/*.ts",
    ".cloudflare/types/**/*.d.ts",
    "cloudflare.config.ts",
    "scripts/cloudflare-*.ts"
  ],
  "exclude": ["server/**/*.test.ts", "server/test-support/**"]
}
