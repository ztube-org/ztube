{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ztube",
  "account_id": "37534748af0ad176a603fd03acf642aa",
  "main": "./server/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "routes": [
    {
      "pattern": "ztube.txchen.win",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "AUTH_MODE": "access"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ztube-db",
      "database_id": "206c2ae5-0ac7-45ac-9e42-9fa79c21cad8",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
